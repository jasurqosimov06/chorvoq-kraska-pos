# .env.local nomi bilan nusxa oling va qiymatlarni to'ldiring (Supabase → Project Settings → API)
# Bo'sh qoldirilsa, ilova lokal (offline) rejimda ishlaydi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Brend (ixtiyoriy; bo'sh = CHORVOQ KRASKA) ---
# Do'kon nomi (sidebar, login, chek, sarlavha, Excel/backup fayl nomlari)
VITE_BRAND_NAME=
# Nom oxiridagi rangli qism, masalan nom=CHORVOQ KRASKA bo'lsa KRASKA
VITE_BRAND_HIGHLIGHT=
# Chekdagi ikkinchi qator (faoliyat turi)
VITE_BRAND_TAGLINE=
# Asosiy rang, och varianti, to'q varianti (hex)
VITE_BRAND_COLOR=
VITE_BRAND_COLOR_2=
VITE_BRAND_COLOR_DARK=
# Brauzer bazasi nomi — bir kompyuterda ikki brendni lokal ishlatsangiz farqli qiling
VITE_DB_NAME=
# Lokal rejimda namuna (kraska) tovarlarini yuklamaslik uchun: false
VITE_SEED_DEMO=
